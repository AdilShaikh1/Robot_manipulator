<?xml version="1.0"?>
<package format="2">
  <name>five_dof_manipulator</name>
  <version>0.0.0</version>
  <description>A 5-DoF arm in Gazebo that detects objects with an RGB-D camera, estimates their 6-DoF pose and grasps them with MoveIt.</description>
  <maintainer email="48984410+AdilShaikh1@users.noreply.github.com">Adil Shaikh</maintainer>
  <author email="48984410+AdilShaikh1@users.noreply.github.com">Adil Shaikh</author>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_controller</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>find_object_2d</exec_depend>
  <exec_depend>nodelet</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>moveit_commander</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf</exec_depend>

  <export>
  </export>
</package>
